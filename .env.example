# Configuration template (never commit a real .env)
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_guidance_db
DB_USER=your_postgres_user
DB_PASSWORD=replace_me

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Select smtp for Gmail, or resend for the Resend HTTP API.
PASSWORD_RESET_PROVIDER=smtp
PASSWORD_RESET_FROM="Global Success <your-sender@gmail.com>"
# Public app/web reset-password URL; the email link appends ?token=...
PASSWORD_RESET_URL=scholarship://reset-password

# Gmail: enable 2-Step Verification, then create an App Password.
# SMTP_PASS is the App Password, never the normal Gmail login password.
# 465 uses implicit TLS; 587 requires STARTTLS. Certificate verification stays on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=replace_with_google_app_password

# Only needed for PASSWORD_RESET_PROVIDER=resend.
# Use an address on a verified domain to deliver to other users.
# RESEND_API_KEY=replace_with_resend_api_key

# Configuration template (never commit a real .env)
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_guidance_db
DB_USER=your_postgres_user
DB_PASSWORD=replace_me

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Required to enable POST /api/auth/forgot-password
# Create a verified sender in Resend: https://resend.com/
RESEND_API_KEY=replace_with_resend_api_key
PASSWORD_RESET_FROM=Scholarship Gateway <no-reply@your-verified-domain.com>
# Public app/web reset-password URL; the email link appends ?token=...
PASSWORD_RESET_URL=https://your-app.example/reset-password
